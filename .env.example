# ============================================================================
# MMPS environment variables
# Copy to .env and fill in. Only the vars for the bots/tools you actually
# exercise locally are required — see AGENTS.md → "Environment Variables".
# ============================================================================

# ----- Runtime -----
PORT=3000
NODE_ENV=development
# Public base URL used for mini-app links (defaults to the Heroku app URL in code).
MMPS_BASE_URL=
# Set IS_PROD=true to boot all 7 bots; leave false locally and use LOCAL_ACTIVE_BOT_ID.
IS_PROD=false

# Which bot to run locally. UPPERCASE id: CHATBOT | CHILLI | COACH | WOLT | WORLDLY | LEARNER
LOCAL_ACTIVE_BOT_ID=CHATBOT


# ----- YouTube collection queue pilot (single app replica only) -----
# direct preserves existing behavior; pubsub fails chatbot startup on invalid setup.
# Currently controls the YouTube-only pilot; other platforms remain direct.
SOCIAL_MEDIA_COLLECTION_MODE=direct
SOCIAL_MEDIA_PUBSUB_PROJECT_ID=
SOCIAL_MEDIA_PUBSUB_TOPIC=social-media-collection-jobs
SOCIAL_MEDIA_PUBSUB_SUBSCRIPTION=social-media-collection-worker
SOCIAL_MEDIA_PUBSUB_DLQ_TOPIC=social-media-collection-jobs-dlq
# Optional private service-account JSON (Heroku: raw JSON; local .env: single-quoted).
# Leave empty for Application Default Credentials / workload identity.
SOCIAL_MEDIA_PUBSUB_CREDENTIALS_JSON=
# ADC file path only, never JSON contents; optional if using the private JSON above.
GOOGLE_APPLICATION_CREDENTIALS=

# ----- MongoDB -----
# Main connection string read by src/core/mongo/mongo-connection.ts (also used by standalone scripts under src/**/scripts/).
MONGO_DB_URL=mongodb://localhost:27017

REDIS_URL=redis://localhost:6379


# ----- LLM provider -----
OPENAI_API_KEY=sk-...


# ----- Telegram bot tokens (per bot) -----
CHATBOT_TELEGRAM_BOT_TOKEN=
CHILLI_TELEGRAM_BOT_TOKEN=
COACH_TELEGRAM_BOT_TOKEN=
WOLT_TELEGRAM_BOT_TOKEN=
# Optional relay for the Wolt restaurants-list fetch. Heroku dyno IPs are shared and rate-limited by
# Wolt's edge (immediate 429s); point this at a relay on a cleaner egress IP (e.g. a free Google Apps
# Script web app) that proxies the request. Leave empty to call Wolt directly. The bot appends ?lat=&lon=.
WOLT_RELAY_URL=
# Comma-separated chat ids for the one-off src/features/wolt/scripts/broadcast.ts script.
WOLT_BROADCAST_CHAT_IDS=
WORLDLY_TELEGRAM_BOT_TOKEN=
# Learner bot 📚 — daily System Design + AI Engineering bites; also serves the mini-app at /learner.
# Set LOCAL_ACTIVE_BOT_ID=LEARNER to run only this bot locally.
LEARNER_TELEGRAM_BOT_TOKEN=
# Rail bot 🚆 — public Israel Rail train search (Hebrew/English, text + voice). Uses REDIS_URL for the search cache and per-user rate limits (falls back to in-memory).
# Set LOCAL_ACTIVE_BOT_ID=RAIL to run only this bot locally.
RAIL_TELEGRAM_BOT_TOKEN=
OWNER_BUSINESS_CONNECTION_ID=
# Cross-bot notification utility (src/services/notifier)
NOTIFIER_TELEGRAM_BOT_TOKEN=
# Playground/test bot
PLAYGROUNDS_TELEGRAM_BOT_TOKEN=

# Telegram MTProto client (user-mode, not bot) for src/services/telegram-client
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=


# Shared password for the standalone savings portfolio at /savings.
SAVINGS_APP_PASSWORD=
# Shared secret for the machine-to-machine POST /api/calendar-events/sync endpoint.
# Callers must send it as `Authorization: Bearer <secret>` (or `X-Api-Key: <secret>`).
CALENDAR_SYNC_SECRET=
# WhatsApp Cloud API webhook bot at GET/POST /whatsapp-webhook (echo replies via Graph API v20.0).
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Any string you choose; must match the "Verify token" entered in the Meta app dashboard.
VERIFY_TOKEN=
# Optional: Meta app secret. When set, POST /whatsapp-webhook rejects requests with an invalid X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Optional: comma-separated phone numbers with country code (e.g. 972501234567). Others get no reply. Empty = everyone.
WHATSAPP_ALLOWED_PHONES=
# Dev-only user id (escape hatch for testing mini-apps locally in a browser).
MY_USER_ID=
WIFE_USER_ID=
MY_USER_NAME=


# ----- Chatbot tuning -----
# Optional: conversation summarization (defaults in code).
# Summarize older turns once the retained history passes this many tokens (primary bound).
CHATBOT_SUMMARY_TRIGGER_TOKENS=
# Also summarize once the thread passes this many messages (OR'd with the token trigger) and
# holds at least 2x CHATBOT_SUMMARY_KEEP_TOKENS, so short messages can't re-summarize every turn.
CHATBOT_SUMMARY_TRIGGER_MESSAGES=
# Keep roughly this many tokens of the most recent turns verbatim after summarizing the rest.
CHATBOT_SUMMARY_KEEP_TOKENS=
# Optional: per-turn token/cost observability. Defaults on; set to false to disable.
CHATBOT_USAGE_TRACKING=
# Optional: location used by the nightly summary's weather section (default Kfar Saba).
CHATBOT_SUMMARY_LOCATION=
# Optional: bounded execution budget per turn (defaults in code).
# Max model requests allowed in a single turn.
CHATBOT_MODEL_CALL_LIMIT=
# Max tool calls allowed in a single turn.
CHATBOT_TOOL_CALL_LIMIT=
# Wall-clock deadline for the whole turn, in milliseconds.
CHATBOT_TURN_TIMEOUT_MS=
# Optional: TikTok video attachments in the daily social media digest (defaults in code).
# Disabled by default. Set to true to attach TikTok videos (text digest is unaffected).
CHATBOT_VIDEO_DIGEST=
# Max TikTok videos attached per chat per digest (default 5).
CHATBOT_VIDEO_DIGEST_MAX_VIDEOS=
# Hard byte cap enforced on the actual download stream (default 49000000).
CHATBOT_VIDEO_DIGEST_MAX_BYTES=
# Per-attempt wall-clock budget for resolving + streaming one video, in ms (default 60000).
CHATBOT_VIDEO_DIGEST_TIMEOUT_MS=
# Overall wall-clock budget for one video across all its retries, in ms (default 120000).
CHATBOT_VIDEO_DIGEST_TOTAL_BUDGET_MS=
# Redirect hops validated against the SSRF guard before streaming (default 5).
CHATBOT_VIDEO_DIGEST_MAX_REDIRECTS=
# Bounded short retries per video, download + safe re-send only (default 2).
CHATBOT_VIDEO_DIGEST_MAX_ATTEMPTS=

# Optional: tweet photos sent as Telegram albums after the daily social media digest.
# Set to false to disable (text digest is unaffected).
CHATBOT_IMAGE_DIGEST=
# Max tweets with photos sent per chat per digest (default 5).
CHATBOT_IMAGE_DIGEST_MAX_POSTS=

# Optional: long-term memory facts injected into the chatbot system prompt each turn.
# Max facts (default 100) and max characters (default 8000) injected, newest first.
CHATBOT_MEMORY_MAX_FACTS=
CHATBOT_MEMORY_MAX_CHARS=

# ----- Weather -----
WEATHERAPI_KEY=


# ----- Google services -----
# Calendar (OAuth refresh token for attendee invites, minted with GMAIL_CLIENT_ID/SECRET; falls back to the service account)
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Maps + Places
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=


# ----- GitHub App (for the github tool) -----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=


# ----- Media -----
IMGUR_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# YouTube transcripts (Supadata fallback when youtube-transcript fails)
SUPADATA_API_KEY=


# ----- Twitter (v2 API) -----
TWITTER_BEARER_TOKEN=

# Optional: browser session cookies of an X account (x.com -> DevTools -> Application -> Cookies).
# Lets the free twitter-scraper read public accounts that X hides from logged-out visitors.
X_AUTH_TOKEN=
X_CT0=


# ----- RapidAPI (TikTok + Booking.com) -----
RAPIDAPI_TIKTOK_KEY=
# RAPIDAPI_BOOKING_KEY powers the Booking.com hotel price watcher.
# Subscribe your RapidAPI account (free tier) to https://rapidapi.com/DataCrawler/api/booking-com15
RAPIDAPI_BOOKING_KEY=

# ----- IGDB (Twitch) -----
# Powers the PS5 game release follower (search games, track release dates).
# Register an app at https://dev.twitch.tv/console/apps (free, requires 2FA on the Twitch account).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=


# ----- Observability (Grafana Cloud via OpenTelemetry) -----
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable telemetry (local dev).
# Values come from your Grafana Cloud "OpenTelemetry" connection page (see below).
OTEL_SERVICE_NAME=mmps
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Auth header is built in code from these two (base64(instanceID:token)):
GRAFANA_OTLP_INSTANCE_ID=
GRAFANA_OTLP_TOKEN=
# Set OTEL_DEBUG=true to log OTLP export attempts/errors while troubleshooting.
OTEL_DEBUG=
